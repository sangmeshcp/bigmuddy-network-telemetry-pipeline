{
  "annotations": {
    "list": []
  },
  "description": "BGP neighbor session state and prefix counts from OpenConfig network-instances via gNMI.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "doc",
      "targetBlank": true,
      "title": "Documentation",
      "type": "link",
      "url": "https://sangameshpatil.com/bigmuddy-network-telemetry-pipeline/"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info{source=~\"$source\", neighbor_neighbor_address=~\"$neighbor\", value=\"ESTABLISHED\"} == 1) or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Sessions established",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info{source=~\"$source\", neighbor_neighbor_address=~\"$neighbor\", value!=\"ESTABLISHED\"} == 1) or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Sessions NOT established",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "ACTIVE": {
                        "color": "red",
                        "index": 3
                      },
                      "CONNECT": {
                        "color": "red",
                        "index": 2
                      },
                      "ESTABLISHED": {
                        "color": "green",
                        "index": 0
                      },
                      "IDLE": {
                        "color": "red",
                        "index": 1
                      },
                      "OPENCONFIRM": {
                        "color": "red",
                        "index": 5
                      },
                      "OPENSENT": {
                        "color": "red",
                        "index": 4
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info{source=~\"$source\", neighbor_neighbor_address=~\"$neighbor\"} == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Session state",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "neighbor_neighbor_address": 2,
              "network_instance_name": 1,
              "source": 0,
              "value": 3
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "source",
                "network_instance_name",
                "neighbor_neighbor_address",
                "value"
              ]
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_afi_safis_afi_safi_state_prefixes_received{source=~\"$source\", neighbor_neighbor_address=~\"$neighbor\"}",
          "legendFormat": "{{source}} {{neighbor_neighbor_address}} {{afi_safi_afi_safi_name}}",
          "refId": "A"
        }
      ],
      "title": "Prefixes received",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_afi_safis_afi_safi_state_prefixes_installed{source=~\"$source\", neighbor_neighbor_address=~\"$neighbor\"}",
          "legendFormat": "{{source}} {{neighbor_neighbor_address}} {{afi_safi_afi_safi_name}}",
          "refId": "A"
        }
      ],
      "title": "Prefixes installed",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "network-telemetry",
    "bgp",
    "openconfig",
    "gnmi"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Data source",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info, source)",
        "hide": 0,
        "includeAll": true,
        "label": "Device",
        "multi": true,
        "name": "source",
        "query": {
          "query": "label_values(network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info, source)",
          "refId": "source-var"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info{source=~\"$source\"}, neighbor_neighbor_address)",
        "hide": 0,
        "includeAll": true,
        "label": "Neighbor",
        "multi": true,
        "name": "neighbor",
        "query": {
          "query": "label_values(network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state_info{source=~\"$source\"}, neighbor_neighbor_address)",
          "refId": "neighbor-var"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "",
  "title": "BGP (OpenConfig / gNMI)",
  "uid": "telemetry-bgp-openconfig",
  "version": 1
}
