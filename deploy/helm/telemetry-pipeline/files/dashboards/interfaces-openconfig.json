{
  "annotations": {
    "list": []
  },
  "description": "Multi-vendor interface throughput, errors and status from OpenConfig /interfaces via gNMI.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "doc",
      "targetBlank": true,
      "title": "Documentation",
      "type": "link",
      "url": "https://sangameshpatil.com/bigmuddy-network-telemetry-pipeline/"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(interfaces_interface_state_oper_status_info{source=~\"$source\", interface_name=~\"$interface\", value=\"UP\"}) or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Interfaces oper UP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((interfaces_interface_state_oper_status_info{source=~\"$source\", interface_name=~\"$interface\", value=\"DOWN\"} == 1) and on (source, interface_name) (interfaces_interface_state_admin_status_info{source=~\"$source\", interface_name=~\"$interface\", value=\"UP\"} == 1)) or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Interfaces oper DOWN (admin UP)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(interfaces_interface_state_counters_in_octets{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval])) * 8 or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Total throughput (in)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(interfaces_interface_state_counters_in_octets{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{source}} {{interface_name}}",
          "refId": "A"
        }
      ],
      "title": "Inbound",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(interfaces_interface_state_counters_out_octets{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{source}} {{interface_name}}",
          "refId": "A"
        }
      ],
      "title": "Outbound",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(interfaces_interface_state_counters_in_errors{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "in {{source}} {{interface_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(interfaces_interface_state_counters_out_errors{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "out {{source}} {{interface_name}}",
          "refId": "B"
        }
      ],
      "title": "Errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(interfaces_interface_state_counters_in_discards{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "in {{source}} {{interface_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(interfaces_interface_state_counters_out_discards{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval])",
          "legendFormat": "out {{source}} {{interface_name}}",
          "refId": "B"
        }
      ],
      "title": "Discards",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, rate(interfaces_interface_state_counters_in_octets{source=~\"$source\", interface_name=~\"$interface\"}[$__rate_interval]) * 8)",
          "legendFormat": "{{source}} {{interface_name}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 interfaces by inbound",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Requires a subscription to .../state/oper-status and string_fields: info on the prometheus output.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "DOWN": {
                        "color": "red",
                        "index": 1
                      },
                      "LOWER_LAYER_DOWN": {
                        "color": "red",
                        "index": 2
                      },
                      "NOT_PRESENT": {
                        "color": "red",
                        "index": 3
                      },
                      "UP": {
                        "color": "green",
                        "index": 0
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "interfaces_interface_state_oper_status_info{source=~\"$source\", interface_name=~\"$interface\"} == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Operational status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "interface_name": 1,
              "source": 0,
              "value": 2
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "source",
                "interface_name",
                "value"
              ]
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "network-telemetry",
    "interfaces",
    "openconfig",
    "gnmi"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Data source",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(interfaces_interface_state_counters_in_octets, source)",
        "hide": 0,
        "includeAll": true,
        "label": "Device",
        "multi": true,
        "name": "source",
        "query": {
          "query": "label_values(interfaces_interface_state_counters_in_octets, source)",
          "refId": "source-var"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(interfaces_interface_state_counters_in_octets{source=~\"$source\"}, interface_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Interface",
        "multi": true,
        "name": "interface",
        "query": {
          "query": "label_values(interfaces_interface_state_counters_in_octets{source=~\"$source\"}, interface_name)",
          "refId": "interface-var"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "",
  "title": "Interfaces (OpenConfig / gNMI)",
  "uid": "telemetry-interfaces-openconfig",
  "version": 1
}
